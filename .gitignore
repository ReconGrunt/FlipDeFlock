# Flipper build tooling
.ufbt/
build/
dist/
# arduino-cli writes here when a platform recipe leaves {sketch_path} unexpanded.
# Worth ignoring AND deleting: application.fam globs sources as "*.c*", which
# also matches the .csv partition table dropped in that tree, and ufbt then
# hands partitions.csv to the linker ("syntax error"). Prefer --output-dir, or
# build the ESP sketches outside the repo entirely.
{sketch_path}/
*.elf
*.map
*.fap

# Binaries are published as release assets, not committed

# Arduino build outputs
esp32_companion/**/build/
*.bin
*.hex

# Host unit-test binary (built by test/Makefile)
test/run_tests
test/run_tests.exe

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Internal multi-agent process notes (kept local, not part of the project)
AGENT_SWARM.md
SPRINT_SUMMARY.md
TESTING.md

# Think-tank / feature-design notes (kept local, not part of the project)
THINKTANK.md
FEATURE_BRIEF.md

# Internal audit / handoff notes (kept local, not part of the project)
HANDOFF-audit.md
flipdeflock-*handoff*.md

# Roadmap and go-to-market planning (kept local, not part of the project)
ROADMAP.md
docs/CATALOG_SUBMISSION.md

